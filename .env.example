# Copy to .env; never commit your actual .env.
# Production refuses to start without at least 16 characters.
STUDIO_PASSWORD=
# The exact HTTPS origin visitors use; no trailing slash.
PUBLIC_ORIGIN=http://localhost:3001
# Set 1 only behind ONE trusted reverse proxy that controls forwarded headers.
TRUST_PROXY=0
PORT=3001
# Optional absolute persistent storage directory; defaults to .data.
# DATA_DIR=/var/lib/motionforge

# OpenAI-compatible text/vision chat completions. No visual generation endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Azure OpenAI v1 example:
# AI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
# AI_MODEL=YOUR-DEPLOYMENT-NAME

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional existing Chrome executable instead of the prepared Headless Shell.
# CHROME_PATH=/usr/bin/chromium
